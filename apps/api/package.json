{
  "name": "@softarq/api",
  "version": "0.5.0",
  "private": true,
  "description": "API de SoftArq (NestJS 12 + TypeScript, PostgreSQL): calculo, catalogos DEMO, sesiones, cotizaciones con versiones y API HTTP local.",
  "type": "module",
  "scripts": {
    "prisma:generar": "node scripts/db/prisma-generar.mjs",
    "build": "pnpm run prisma:generar && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run prisma:generar && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integracion": "pnpm run prisma:generar && vitest run --config vitest.integracion.config.ts",
    "db:credenciales": "node scripts/db/generar-credenciales.mjs",
    "db:migrar": "node scripts/db/migrar.mjs",
    "db:migrar:test": "node scripts/db/migrar.mjs --test",
    "db:nueva-migracion": "node scripts/db/nueva-migracion.mjs",
    "db:cargar-demo": "pnpm run build && node dist/modules/catalogos/demo/ejecutar-carga-demo.js",
    "db:cargar-usuarios-demo": "pnpm run build && node dist/modules/autenticacion/demo/ejecutar-carga-usuarios-demo.js",
    "db:purgar-sesiones": "node scripts/db/purgar-sesiones.mjs",
    "db:purgar-idempotencia": "node scripts/db/purgar-idempotencia.mjs",
    "documentos:revisar": "pnpm run build && node dist/modules/cotizaciones/mantenimiento/revisar-documentos.js",
    "respaldo:crear": "node scripts/respaldo/respaldar.mjs",
    "respaldo:probar-concurrencia": "pnpm run build && node scripts/respaldo/probar-concurrencia.mjs",
    "respaldo:verificar": "node scripts/respaldo/verificar.mjs",
    "respaldo:restaurar": "node scripts/respaldo/restaurar.mjs",
    "respaldo:probar-restauracion": "pnpm run build && node scripts/respaldo/probar-restauracion.mjs",
    "start": "node dist/main.js",
    "openapi:generar": "pnpm run build && node dist/http/generar-openapi.js",
    "build:e2e": "pnpm run prisma:generar && tsc -p tsconfig.e2e.json",
    "e2e:servidor": "node dist-e2e/pruebas-e2e/servidor-e2e.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@softarq/contracts": "workspace:*",
    "cookie": "0.7.2",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pdfkit": "0.17.6",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
