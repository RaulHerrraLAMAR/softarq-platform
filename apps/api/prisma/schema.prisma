// Esquema de persistencia de SoftArq — módulo 2: catálogos para el motor de cálculo;
// módulo 5: usuarios, pertenencias y sesiones; módulo 6: clientes, proyectos y cotizaciones.
// Ver docs/adr/0004-persistencia-catalogos.md, docs/adr/0007-autenticacion-sesiones.md y
// docs/adr/0008-cotizaciones-versiones-folios.md.
//
// Convenciones:
// - Tablas y columnas en snake_case (@@map/@map); modelos en español.
// - Toda entidad propia de una organización lleva organizacion_id, UNIQUE(organizacion_id, id)
//   y UNIQUE(organizacion_id, codigo). Las FK entre entidades propias son COMPUESTAS
//   (organizacion_id, x_id), de modo que PostgreSQL impide relacionar organizaciones distintas.
// - Importes y cantidades en NUMERIC con precisión por clase de dato (nunca Float).
// - Vigencias en DATE (sin hora ni zona horaria).
// - Los CHECK y la restricción de exclusión de precios están en el SQL de la migración
//   (Prisma no los representa; ver prisma/migrations/*/migration.sql).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Referencia común (catálogo de unidades de la fase 1, modBuild.bas). Se carga en la migración.
model Unidad {
  clave    String @id @db.VarChar(10)
  nombre   String @db.VarChar(60)
  magnitud String @db.VarChar(20)

  insumos                Insumo[]
  conversionesOrigen     Conversion[]     @relation("ConversionOrigen")
  conversionesDestino    Conversion[]     @relation("ConversionDestino")
  productosCompra        Producto[]
  tarifas                TarifaManoObra[]
  conceptos              Concepto[]
  componentesRendimiento Componente[]
  tiposAdicional         TipoAdicional[]

  @@map("unidad")
}

model Organizacion {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo   String   @unique @db.VarChar(40)
  nombre   String   @db.VarChar(200)
  esDemo   Boolean  @map("es_demo")
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  parametros     ParametrosCalculo?
  insumos        Insumo[]
  conversiones   Conversion[]
  proveedores    Proveedor[]
  productos      Producto[]
  precios        Precio[]
  tarifas        TarifaManoObra[]
  conceptos      Concepto[]
  componentes    Componente[]
  tiposAdicional TipoAdicional[]
  membresias     Membresia[]
  clientes       Cliente[]
  contadores     Contador[]
  bitacora       Bitacora[]
  emisor         Emisor?

  @@map("organizacion")
}

/// Parámetros de venta de la organización. NULL = no definido (bloquea: BL-12, BL-13); "0" es un valor definido.
model ParametrosCalculo {
  organizacionId      String   @id @map("organizacion_id") @db.Uuid
  ambiente            String   @db.VarChar(12)
  moneda              String   @default("MXN") @db.VarChar(3)
  recargoSobreCosto   Decimal? @map("recargo_sobre_costo") @db.Decimal(7, 6)
  impuestoTasa        Decimal? @map("impuesto_tasa") @db.Decimal(7, 6)
  impuestoBase        String?  @map("impuesto_base") @db.VarChar(30)
  impuestoTratamiento String?  @map("impuesto_tratamiento") @db.VarChar(500)
  impuestoNombre      String?  @map("impuesto_nombre") @db.VarChar(100)
  vigenciaDias        Int?     @map("vigencia_dias")

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("parametros_calculo")
}

model Insumo {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  codigo         String  @db.VarChar(40)
  descripcion    String  @db.VarChar(500)
  unidadBase     String  @map("unidad_base") @db.VarChar(10)
  activo         Boolean @default(true)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unidad       Unidad       @relation(fields: [unidadBase], references: [clave], onDelete: Restrict, onUpdate: Restrict)
  conversiones Conversion[]
  productos    Producto[]
  componentes  Componente[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("insumo")
}

model Conversion {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  insumoId       String  @map("insumo_id") @db.Uuid
  unidadOrigen   String  @map("unidad_origen") @db.VarChar(10)
  unidadDestino  String  @map("unidad_destino") @db.VarChar(10)
  /// Unidades de destino por unidad de origen (> 0).
  factor         Decimal @db.Decimal(20, 10)
  fuente         String  @db.VarChar(500)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  insumo       Insumo       @relation(fields: [organizacionId, insumoId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  origen       Unidad       @relation("ConversionOrigen", fields: [unidadOrigen], references: [clave], onDelete: Restrict, onUpdate: Restrict)
  destino      Unidad       @relation("ConversionDestino", fields: [unidadDestino], references: [clave], onDelete: Restrict, onUpdate: Restrict)

  @@unique([insumoId, unidadOrigen, unidadDestino])
  @@map("conversion")
}

model Proveedor {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  codigo         String  @db.VarChar(40)
  nombre         String  @db.VarChar(200)
  activo         Boolean @default(true)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  precios      Precio[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("proveedor")
}

model Producto {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId   String   @map("organizacion_id") @db.Uuid
  codigo           String   @db.VarChar(40)
  insumoId         String   @map("insumo_id") @db.Uuid
  descripcion      String   @db.VarChar(500)
  presentacion     String   @db.VarChar(200)
  unidadCompra     String   @map("unidad_compra") @db.VarChar(10)
  /// Contenido de una unidad de compra en la unidad base del insumo (> 0).
  contenido        Decimal  @db.Decimal(20, 6)
  fraccionable     Boolean
  /// Obligatorio (> 0) si es fraccionable; NULL si no.
  incrementoMinimo Decimal? @map("incremento_minimo") @db.Decimal(20, 6)
  activo           Boolean  @default(true)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  insumo       Insumo       @relation(fields: [organizacionId, insumoId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  unidad       Unidad       @relation(fields: [unidadCompra], references: [clave], onDelete: Restrict, onUpdate: Restrict)
  precios      Precio[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("producto")
}

/// Precio de un producto por proveedor. No se edita: se registra uno nuevo o se anula (Val_Precio).
model Precio {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  codigo         String   @db.VarChar(40)
  productoId     String   @map("producto_id") @db.Uuid
  proveedorId    String   @map("proveedor_id") @db.Uuid
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(18, 6)
  vigenteDesde   DateTime @map("vigente_desde") @db.Date
  vigenteHasta   DateTime @map("vigente_hasta") @db.Date
  anulado        Boolean  @default(false)
  fuente         String   @db.VarChar(500)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  producto     Producto     @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  proveedor    Proveedor    @relation(fields: [organizacionId, proveedorId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizacionId, codigo])
  @@map("precio")
}

model TarifaManoObra {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId     String   @map("organizacion_id") @db.Uuid
  codigo             String   @db.VarChar(40)
  modalidad          String   @db.VarChar(12)
  descripcion        String   @db.VarChar(500)
  unidad             String   @db.VarChar(10)
  importe            Decimal  @db.Decimal(18, 6)
  /// Solo en JORNADA (> 0); NULL en las demás modalidades.
  rendimientoJornada Decimal? @map("rendimiento_jornada") @db.Decimal(20, 6)
  vigenteDesde       DateTime @map("vigente_desde") @db.Date
  vigenteHasta       DateTime @map("vigente_hasta") @db.Date
  activa             Boolean  @default(true)
  fuente             String   @db.VarChar(500)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unidadRef    Unidad       @relation(fields: [unidad], references: [clave], onDelete: Restrict, onUpdate: Restrict)
  conceptos    Concepto[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("tarifa_mano_obra")
}

model Concepto {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId   String  @map("organizacion_id") @db.Uuid
  codigo           String  @db.VarChar(40)
  descripcion      String  @db.VarChar(500)
  unidad           String  @db.VarChar(10)
  tipoFormula      String  @map("tipo_formula") @db.VarChar(10)
  permiteDescuento Boolean @map("permite_descuento")
  clase            String  @db.VarChar(15)
  estado           String  @db.VarChar(10)
  tarifaId         String? @map("tarifa_id") @db.Uuid
  activo           Boolean @default(true)

  organizacion Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unidadRef    Unidad          @relation(fields: [unidad], references: [clave], onDelete: Restrict, onUpdate: Restrict)
  tarifa       TarifaManoObra? @relation(fields: [organizacionId, tarifaId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  componentes  Componente[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("concepto")
}

/// Componente de un concepto. `orden` conserva el orden del libro: define el remanente del prorrateo (CR-08).
model Componente {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId    String   @map("organizacion_id") @db.Uuid
  codigo            String   @db.VarChar(40)
  conceptoId        String   @map("concepto_id") @db.Uuid
  insumoId          String   @map("insumo_id") @db.Uuid
  orden             Int
  rendimiento       Decimal  @db.Decimal(20, 6)
  unidadRendimiento String   @map("unidad_rendimiento") @db.VarChar(10)
  desperdicio       Decimal  @db.Decimal(7, 6)
  factorTraslape    Decimal? @map("factor_traslape") @db.Decimal(9, 6)
  fuente            String   @db.VarChar(500)
  fecha             DateTime @db.Date
  responsable       String   @db.VarChar(200)
  activo            Boolean  @default(true)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  concepto     Concepto     @relation(fields: [organizacionId, conceptoId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  insumo       Insumo       @relation(fields: [organizacionId, insumoId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  unidad       Unidad       @relation(fields: [unidadRendimiento], references: [clave], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizacionId, codigo])
  @@unique([conceptoId, orden])
  @@map("componente")
}

model TipoAdicional {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String  @map("organizacion_id") @db.Uuid
  codigo         String  @db.VarChar(40)
  categoria      String  @db.VarChar(40)
  descripcion    String  @db.VarChar(500)
  unidad         String  @db.VarChar(10)
  regla          String  @db.VarChar(20)
  activo         Boolean @default(true)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unidadRef    Unidad       @relation(fields: [unidad], references: [clave], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizacionId, codigo])
  @@map("tipo_adicional")
}

// ---------------------------------------------------------------------------
// Módulo 5: identidad y sesiones (ADR-0007).
// La aplicación (softarq_app) solo LEE usuario y membresia; las cuentas DEMO las crea el rol
// migrador. En sesion puede insertar y actualizar únicamente actividad y revocación (sin DELETE).
// ---------------------------------------------------------------------------

/// Persona con acceso. Es global: la organización la aporta la pertenencia (membresia).
model Usuario {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalizado (minúsculas, sin espacios en los extremos; CHECK en la migración).
  correo               String   @unique @db.VarChar(254)
  nombre               String   @db.VarChar(200)
  /// Cadena PHC de Argon2id (CHECK en la migración). Nunca sale de la API.
  hashContrasena       String   @map("hash_contrasena") @db.Text
  activo               Boolean  @default(true)
  esDemo               Boolean  @map("es_demo")
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  contrasenaCambiadaEn DateTime @default(now()) @map("contrasena_cambiada_en") @db.Timestamptz(3)

  membresias Membresia[]

  @@map("usuario")
}

/// Pertenencia de un usuario a una organización, con sus funciones (las del libro, D-20).
model Membresia {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  usuarioId      String   @map("usuario_id") @db.Uuid
  /// PREPARADOR | REVISOR | ADMIN_CATALOGO | ADMIN_SISTEMA (CHECK en la migración).
  funciones      String[] @db.VarChar(20)
  activa         Boolean  @default(true)
  creadaEn       DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sesiones     Sesion[]

  // Autoría (módulo 6): FK compuestas (organización, usuario); el autor pertenece a la organización.
  clientesCreados      Cliente[]            @relation("ClienteCreadoPor")
  clientesModificados  Cliente[]            @relation("ClienteModificadoPor")
  proyectosCreados     Proyecto[]           @relation("ProyectoCreadoPor")
  proyectosModificados Proyecto[]           @relation("ProyectoModificadoPor")
  cotizacionesCreadas  Cotizacion[]
  borradoresGuardados  CotizacionBorrador[]
  versionesCreadas     CotizacionVersion[]
  // Revisión (módulo 7, ADR-0009).
  revisionesPreparadas Revision[]           @relation("RevisionPreparador")
  revisionesEnviadas   Revision[]           @relation("RevisionEnviadaPor")
  revisionesResueltas  Revision[]           @relation("RevisionResueltaPor")
  eventosRevision      RevisionEvento[]
  // Emisión, anulación y descarte (módulo 8, ADR-0010).
  emisionesPreparadas  Emision[]            @relation("EmisionPreparadaPor")
  emisionesAprobadas   Emision[]            @relation("EmisionAprobadaPor")
  emisionesEmitidas    Emision[]            @relation("EmisionEmitidaPor")
  emisoresModificados  Emisor[]
  cotizacionesDescartadas Cotizacion[]      @relation("CotizacionDescartadaPor")
  eventos              Bitacora[]
  idempotencia         Idempotencia[]
  respuestasCliente    RespuestaClienteEvento[]
  excepcionesDecididas ExcepcionDecision[]

  @@unique([organizacionId, usuarioId])
  @@index([usuarioId])
  @@map("membresia")
}

/// Sesión opaca. Solo se guarda el SHA-256 del token (nunca el utilizable). El token CSRF no se
/// guarda: es un HMAC del id de sesión con una clave aleatoria del proceso (ADR-0007).
/// PREVIA: anterior al acceso (protege el inicio de sesión con CSRF); USUARIO: autenticada.
model Sesion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              String    @db.VarChar(10)
  tokenHash         Bytes     @unique @map("token_hash")
  organizacionId    String?   @map("organizacion_id") @db.Uuid
  usuarioId         String?   @map("usuario_id") @db.Uuid
  creadaEn          DateTime  @map("creada_en") @db.Timestamptz(3)
  ultimaActividadEn DateTime  @map("ultima_actividad_en") @db.Timestamptz(3)
  expiraEn          DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn        DateTime? @map("revocada_en") @db.Timestamptz(3)
  motivoRevocacion  String?   @map("motivo_revocacion") @db.VarChar(30)

  /// FK compuesta: la sesión no puede unir un usuario con una organización a la que no pertenece.
  membresia Membresia? @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesion")
}

// ---------------------------------------------------------------------------
// Módulo 6: clientes, proyectos y cotizaciones con folio, borrador y versiones (ADR-0008).
// softarq_app: versiones, bitácora e idempotencia solo SELECT/INSERT (sin UPDATE ni DELETE);
// en las demás, UPDATE solo de columnas editables (scripts/db/permisos-app.sql). Las altas con
// folio o código y las escrituras condicionadas por revisión son funciones PL/pgSQL de una sola
// sentencia (ver la migración). Los CHECK y el trigger de inmutabilidad están en el SQL.
// ---------------------------------------------------------------------------

/// Quien recibe la cotización (tblClientes). Sin cuenta. Solo los campos que este flujo necesita.
model Cliente {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  /// CLI-00001, por organización (contador; no se reutiliza).
  codigo         String   @db.VarChar(20)
  /// nombre_razon_social del libro.
  nombre         String   @db.VarChar(200)
  /// Contacto del cliente (BL-01: nombre y teléfono o correo para emitir; módulo 8).
  contactoNombre   String?  @map("contacto_nombre") @db.VarChar(200)
  contactoTelefono String?  @map("contacto_telefono") @db.VarChar(40)
  contactoCorreo   String?  @map("contacto_correo") @db.VarChar(254)
  activo         Boolean  @default(true)
  /// Control de concurrencia optimista de la edición.
  revision       Int      @default(0)
  creadoPor      String   @map("creado_por") @db.Uuid
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  modificadoPor  String   @map("modificado_por") @db.Uuid
  modificadoEn   DateTime @default(now()) @map("modificado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  autor        Membresia    @relation("ClienteCreadoPor", fields: [organizacionId, creadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  modificador  Membresia    @relation("ClienteModificadoPor", fields: [organizacionId, modificadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  proyectos    Proyecto[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  @@map("cliente")
}

/// Trabajo del cliente (tblProyectos). Pertenece a un solo cliente, que no cambia.
model Proyecto {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId    String   @map("organizacion_id") @db.Uuid
  clienteId         String   @map("cliente_id") @db.Uuid
  /// PRY-00001, por organización.
  codigo            String   @db.VarChar(20)
  nombre            String   @db.VarChar(200)
  municipio         String?  @db.VarChar(120)
  entidadFederativa String?  @map("entidad_federativa") @db.VarChar(60)
  descripcion       String?  @db.VarChar(500)
  activo            Boolean  @default(true)
  revision          Int      @default(0)
  creadoPor         String   @map("creado_por") @db.Uuid
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  modificadoPor     String   @map("modificado_por") @db.Uuid
  modificadoEn      DateTime @default(now()) @map("modificado_en") @db.Timestamptz(3)

  cliente      Cliente      @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  autor        Membresia    @relation("ProyectoCreadoPor", fields: [organizacionId, creadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  modificador  Membresia    @relation("ProyectoModificadoPor", fields: [organizacionId, modificadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  cotizaciones Cotizacion[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, codigo])
  /// Destino de la FK compuesta de cotizacion: el proyecto es de ESE cliente y de ESA organización.
  @@unique([organizacionId, clienteId, id])
  @@map("proyecto")
}

/// Cotización con folio (tblCotizaciones). El folio fija cliente y proyecto.
model Cotizacion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  /// COT-AAAA-NNNNN (formato del libro); contador propio de la web por organización y año.
  folio          String   @db.VarChar(20)
  anioFolio      Int      @map("anio_folio")
  /// WEB_DEMO: historial independiente de la fase Excel (CHECK).
  origen         String   @db.VarChar(20)
  /// ACTIVO | DESCARTADO (CHECK). El descarte (módulo 8) es definitivo y no reutiliza el folio.
  estadoFolio    String   @default("ACTIVO") @map("estado_folio") @db.VarChar(20)
  /// Descarte (B-37): quién, cuándo y por qué. Solo los fija `softarq_descartar_cotizacion`.
  descartadaPor  String?   @map("descartada_por") @db.Uuid
  descartadaEn   DateTime? @map("descartada_en") @db.Timestamptz(3)
  motivoDescarte String?   @map("motivo_descarte") @db.VarChar(500)
  clienteId      String   @map("cliente_id") @db.Uuid
  proyectoId     String   @map("proyecto_id") @db.Uuid
  /// Último número de versión asignado (0 = sin versiones). Se incrementa atómicamente.
  ultimaVersion  Int      @default(0) @map("ultima_version")
  creadoPor      String   @map("creado_por") @db.Uuid
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  proyecto   Proyecto            @relation(fields: [organizacionId, clienteId, proyectoId], references: [organizacionId, clienteId, id], onDelete: Restrict, onUpdate: Restrict)
  autor      Membresia           @relation(fields: [organizacionId, creadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  descartador Membresia?         @relation("CotizacionDescartadaPor", fields: [organizacionId, descartadaPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  borrador   CotizacionBorrador?
  versiones  CotizacionVersion[]
  revisiones Revision[]
  emisiones  Emision[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, folio])
  /// Destino de la FK de `revision`: identificador, organización y folio coherentes (ADR-0009).
  @@unique([organizacionId, id, folio])
  @@index([organizacionId, creadoEn])
  @@map("cotizacion")
}

/// Captura editable (1:1). `revision` es el control de concurrencia optimista.
model CotizacionBorrador {
  cotizacionId   String   @id @map("cotizacion_id") @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  /// EsquemaCapturaBorrador (contracts): códigos y textos; null = sin capturar.
  captura        Json
  revision       Int      @default(0)
  actualizadoPor String   @map("actualizado_por") @db.Uuid
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  cotizacion Cotizacion @relation(fields: [organizacionId, cotizacionId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  autor      Membresia  @relation(fields: [organizacionId, actualizadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizacionId, cotizacionId])
  @@map("cotizacion_borrador")
}

/// Versión guardada: registro histórico INMUTABLE de un cálculo válido hecho en el servidor.
/// entrada_calculo y resultado_interno contienen costos internos y nunca salen de la API.
model CotizacionVersion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId      String   @map("organizacion_id") @db.Uuid
  cotizacionId        String   @map("cotizacion_id") @db.Uuid
  numero              Int
  revisionBorrador    Int      @map("revision_borrador")
  captura             Json
  solicitudCalculo    Json     @map("solicitud_calculo")
  entradaCalculo      Json     @map("entrada_calculo")
  resultadoInterno    Json     @map("resultado_interno")
  proyeccionComercial Json     @map("proyeccion_comercial")
  avisos              Json
  total               Decimal  @db.Decimal(18, 2)
  fechaCalculo        DateTime @map("fecha_calculo") @db.Date
  versionMotor        String   @map("version_motor") @db.VarChar(40)
  /// SHA-256 de entrada y resultado (equivalente a sello_calculo, BL-16).
  huellaCalculo       Bytes    @map("huella_calculo")
  /// SHA-256 solo de los valores de referencia (parámetros, precios, consumos y tarifas).
  huellaReferencia    Bytes    @map("huella_referencia")
  clienteCodigo       String   @map("cliente_codigo") @db.VarChar(20)
  clienteNombre       String   @map("cliente_nombre") @db.VarChar(200)
  proyectoCodigo      String   @map("proyecto_codigo") @db.VarChar(20)
  proyectoNombre      String   @map("proyecto_nombre") @db.VarChar(200)
  proyectoUbicacion   String?  @map("proyecto_ubicacion") @db.VarChar(200)
  proyectoDescripcion String?  @map("proyecto_descripcion") @db.VarChar(500)
  autorId             String   @map("autor_id") @db.Uuid
  autorNombre         String   @map("autor_nombre") @db.VarChar(200)
  motivo              String?  @db.VarChar(500)
  resumenCambios      Json     @map("resumen_cambios")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  cotizacion Cotizacion @relation(fields: [organizacionId, cotizacionId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  autor      Membresia  @relation(fields: [organizacionId, autorId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  revisiones Revision[]
  emisiones  Emision[]

  @@unique([cotizacionId, numero])
  @@unique([organizacionId, id])
  /// Destino de la FK de `revision`: identificador, organización, cotización y número coherentes (ADR-0009).
  @@unique([organizacionId, cotizacionId, numero, id])
  @@map("cotizacion_version")
}

/// Revisión de UNA versión inmutable (módulo 7, ADR-0009): estado propio, separado del contenido
/// histórico. La versión nunca se modifica; la aprobación de vN no se aplica a otra versión.
/// Estados: PENDIENTE → APROBADA | CAMBIOS_SOLICITADOS | RETIRADA (terminales; trigger en la base).
model Revision {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String    @map("organizacion_id") @db.Uuid
  cotizacionId   String    @map("cotizacion_id") @db.Uuid
  /// Copia del folio (FK compuesta con la cotización: no puede discrepar).
  folio          String    @db.VarChar(20)
  versionId      String    @map("version_id") @db.Uuid
  versionNumero  Int       @map("version_numero")
  /// Total de la versión revisada (copiado por la base desde la versión, nunca desde el cliente).
  total          Decimal   @db.Decimal(18, 2)
  /// Autor de la versión (BL-17: no puede aprobarla).
  preparadorId   String    @map("preparador_id") @db.Uuid
  estado         String    @db.VarChar(20)
  /// Ficha de concurrencia optimista: cada transición la incrementa.
  revision       Int       @default(0)
  enviadoPor     String    @map("enviado_por") @db.Uuid
  enviadoEn      DateTime  @default(now()) @map("enviado_en") @db.Timestamptz(3)
  resueltaPor    String?   @map("resuelta_por") @db.Uuid
  resueltaEn     DateTime? @map("resuelta_en") @db.Timestamptz(3)
  /// Observaciones de la decisión o motivo de la retirada.
  observaciones  String?   @db.VarChar(2000)

  cotizacion Cotizacion        @relation(fields: [organizacionId, cotizacionId, folio], references: [organizacionId, id, folio], onDelete: Restrict, onUpdate: Restrict)
  version    CotizacionVersion @relation(fields: [organizacionId, cotizacionId, versionNumero, versionId], references: [organizacionId, cotizacionId, numero, id], onDelete: Restrict, onUpdate: Restrict)
  preparador Membresia         @relation("RevisionPreparador", fields: [organizacionId, preparadorId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  emisor     Membresia         @relation("RevisionEnviadaPor", fields: [organizacionId, enviadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  resolutor  Membresia?        @relation("RevisionResueltaPor", fields: [organizacionId, resueltaPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  eventos    RevisionEvento[]
  emisiones  Emision[]
  excepciones ExcepcionDecision[]

  @@unique([organizacionId, id])
  /// Destino de la FK de `emision`: la aprobación usada es de ESA versión (ADR-0010).
  @@unique([organizacionId, id, versionId])
  @@index([organizacionId, estado, enviadoEn])
  @@index([organizacionId, cotizacionId])
  @@map("revision")
}

/// Historial de una revisión: solo alta (sin UPDATE ni DELETE, también para el propietario).
model RevisionEvento {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  secuencia      Int
  /// ENVIADA | APROBADA | CAMBIOS_SOLICITADOS | RETIRADA | APROBACION_ANULADA (módulo 8)
  tipo           String   @db.VarChar(30)
  estadoAnterior String?  @map("estado_anterior") @db.VarChar(20)
  estadoNuevo    String   @map("estado_nuevo") @db.VarChar(20)
  usuarioId      String   @map("usuario_id") @db.Uuid
  /// Nombre copiado: el historial no cambia si cambia la cuenta.
  usuarioNombre  String   @map("usuario_nombre") @db.VarChar(200)
  observaciones  String?  @db.VarChar(2000)
  /// Códigos de aviso presentes al registrar el evento (no se marcan como atendidos).
  avisos         Json
  ocurridoEn     DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  revision Revision  @relation(fields: [organizacionId, revisionId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict)
  usuario  Membresia @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, secuencia])
  @@map("revision_evento")
}

/// Datos del emisor por organización (17 CONFIG: EMISOR_*; BL-15). Se copian a cada emisión: un
/// cambio posterior no altera documentos emitidos. `logo_clave` nombra un recurso local de la API.
model Emisor {
  organizacionId String   @id @map("organizacion_id") @db.Uuid
  nombre         String?  @db.VarChar(200)
  domicilio      String?  @db.VarChar(300)
  telefono       String?  @db.VarChar(40)
  correo         String?  @db.VarChar(254)
  /// DEMO = recursos/pdf/logo-demo.png (CHECK); `null` = sin logotipo (BL-15).
  logoClave      String?  @map("logo_clave") @db.VarChar(20)
  /// Datos ficticios de demostración (DEMO_EMISOR_* del libro).
  esDemo         Boolean  @map("es_demo")
  revision       Int      @default(0)
  /// `null` = cargado por `db:cargar-demo` (sin persona); después, quien lo editó.
  modificadoPor  String?  @map("modificado_por") @db.Uuid
  modificadoEn   DateTime @default(now()) @map("modificado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modificador  Membresia?   @relation(fields: [organizacionId, modificadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@map("emisor")
}

/// Emisión de una versión aprobada (módulo 8, ADR-0010): registro inmutable, independiente del
/// snapshot calculado. Guarda la estructura comercial exacta que recibió el generador del PDF y la
/// identidad del archivo (clave del servidor, tamaño y SHA-256). Sin UPDATE ni DELETE.
model Emision {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId   String   @map("organizacion_id") @db.Uuid
  cotizacionId     String   @map("cotizacion_id") @db.Uuid
  folio            String   @db.VarChar(20)
  versionId        String   @map("version_id") @db.Uuid
  versionNumero    Int      @map("version_numero")
  /// Aprobación usada (revisión APROBADA y sin anular de ESTA versión).
  revisionId       String   @map("revision_id") @db.Uuid
  /// WEB_DEMO (CHECK).
  origen           String   @db.VarChar(20)
  /// DEMO | PRODUCCION
  ambiente         String   @db.VarChar(12)
  preparadoPor     String   @map("preparado_por") @db.Uuid
  preparadoNombre  String   @map("preparado_nombre") @db.VarChar(200)
  aprobadoPor      String   @map("aprobado_por") @db.Uuid
  aprobadoNombre   String   @map("aprobado_nombre") @db.VarChar(200)
  emitidoPor       String   @map("emitido_por") @db.Uuid
  emitidoNombre    String   @map("emitido_nombre") @db.VarChar(200)
  emitidoEn        DateTime @default(now()) @map("emitido_en") @db.Timestamptz(3)
  /// Fecha de negocio del servidor (zona SOFTARQ_ZONA_HORARIA) y vigencia (CR-16).
  fechaEmision     DateTime @map("fecha_emision") @db.Date
  vigenciaDias     Int      @map("vigencia_dias")
  vigenteHasta     DateTime @map("vigente_hasta") @db.Date
  total            Decimal  @db.Decimal(18, 2)
  /// Estructura comercial entregada al generador (sin costos, proveedores ni consumos).
  contenido        Json
  plantillaVersion String   @map("plantilla_version") @db.VarChar(40)
  /// Ruta relativa a SOFTARQ_DIR_DOCUMENTOS, construida solo con uuids del servidor.
  archivoClave     String   @map("archivo_clave") @db.VarChar(200)
  archivoBytes     Int      @map("archivo_bytes")
  archivoSha256    Bytes    @map("archivo_sha256")

  cotizacion Cotizacion        @relation(fields: [organizacionId, cotizacionId, folio], references: [organizacionId, id, folio], onDelete: Restrict, onUpdate: Restrict)
  version    CotizacionVersion @relation(fields: [organizacionId, cotizacionId, versionNumero, versionId], references: [organizacionId, cotizacionId, numero, id], onDelete: Restrict, onUpdate: Restrict)
  revision   Revision          @relation(fields: [organizacionId, revisionId, versionId], references: [organizacionId, id, versionId], onDelete: Restrict, onUpdate: Restrict)
  preparador Membresia         @relation("EmisionPreparadaPor", fields: [organizacionId, preparadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  aprobador  Membresia         @relation("EmisionAprobadaPor", fields: [organizacionId, aprobadoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  emisor     Membresia         @relation("EmisionEmitidaPor", fields: [organizacionId, emitidoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)
  respuestas RespuestaClienteEvento[]

  /// Una emisión por versión.
  @@unique([versionId])
  @@unique([organizacionId, id])
  @@unique([archivoClave])
  @@index([organizacionId, cotizacionId])
  @@map("emision")
}

/// Registro comercial interno inmutable por emisión (ADR-0013); la cabeza se deriva de numero.
model RespuestaClienteEvento {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId   String   @map("organizacion_id") @db.Uuid
  emisionId        String   @map("emision_id") @db.Uuid
  numero           Int
  anteriorId       String?  @map("anterior_id") @db.Uuid
  tipo             String   @db.VarChar(12)
  resultado        String   @db.VarChar(10)
  fechaRespuesta   DateTime @map("fecha_respuesta") @db.Date
  nota             String?  @db.VarChar(2000)
  registradoPor    String   @map("registrado_por") @db.Uuid
  registradoNombre String   @map("registrado_nombre") @db.VarChar(200)
  registradoEn     DateTime @default(now()) @map("registrado_en") @db.Timestamptz(3)
  fechaRegistro    DateTime @map("fecha_registro") @db.Date
  motivo           String?  @db.VarChar(500)

  emision   Emision   @relation(fields: [organizacionId, emisionId], references: [organizacionId, id], onDelete: Restrict, onUpdate: Restrict, map: "respuesta_evento_emision_fk")
  autor     Membresia @relation(fields: [organizacionId, registradoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict, map: "respuesta_evento_autor_fk")
  anterior  RespuestaClienteEvento?  @relation("CorreccionRespuesta", fields: [organizacionId, emisionId, anteriorId], references: [organizacionId, emisionId, id], onDelete: Restrict, onUpdate: Restrict, map: "respuesta_evento_anterior_fk")
  siguientes RespuestaClienteEvento[] @relation("CorreccionRespuesta")

  @@unique([organizacionId, emisionId, id], map: "respuesta_evento_org_emision_id_key")
  @@unique([organizacionId, emisionId, numero], map: "respuesta_evento_numero_key")
  @@unique([organizacionId, emisionId, anteriorId], map: "respuesta_evento_anterior_key")
  @@map("respuesta_cliente_evento")
}

/// Contadores de identificadores (tblContadores): CLI, PRY y COT-AAAA, por organización.
model Contador {
  organizacionId String @map("organizacion_id") @db.Uuid
  entidad        String @db.VarChar(20)
  ultimo         Int

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizacionId, entidad])
  @@map("contador")
}

/// Eventos mínimos (tblBitacora): creación, edición y versionado. Sin capturas, contraseñas ni tokens.
model Bitacora {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  /// cliente | proyecto | cotizacion | emisor (referencia polimórfica: sin FK).
  entidad        String   @db.VarChar(20)
  entidadId      String   @map("entidad_id") @db.Uuid
  tipo           String   @db.VarChar(40)
  usuarioId      String   @map("usuario_id") @db.Uuid
  detalle        Json
  ocurridoEn     DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usuario      Membresia    @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizacionId, entidad, entidadId, ocurridoEn])
  @@map("bitacora")
}

/// Claves de idempotencia de las altas (ámbito: organización + usuario + clave; 24 h).
/// Solo se registran los éxitos, en la misma sentencia que crea el recurso.
model Idempotencia {
  organizacionId  String   @map("organizacion_id") @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  clave           String   @db.Uuid
  operacion       String   @db.VarChar(40)
  /// SHA-256 de operación, parámetros de ruta y cuerpo canónico.
  huellaSolicitud Bytes    @map("huella_solicitud")
  recursoTipo     String   @map("recurso_tipo") @db.VarChar(20)
  recursoId       String   @map("recurso_id") @db.Uuid
  creadaEn        DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  expiraEn        DateTime @map("expira_en") @db.Timestamptz(3)

  usuario Membresia @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizacionId, usuarioId, clave])
  @@index([expiraEn])
  @@map("idempotencia")
}

/// Decisión del Revisor sobre la excepción N de una versión (módulo 10, ADR-0014; B-29,
/// `Exc_Resolver`). Solo alta: una decisión por excepción y versión, sin UPDATE ni DELETE
/// (disparador también para el propietario). Se toma durante una revisión PENDIENTE de esa versión.
model ExcepcionDecision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  cotizacionId   String   @map("cotizacion_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  /// Posición de la excepción en `captura.excepciones` de la versión (1…n).
  numero         Int
  decision       String   @db.VarChar(10)
  comentario     String?  @db.VarChar(2000)
  /// Preparador de la revisión (copiado por la base): BL-17 con CHECK.
  preparadorId   String   @map("preparador_id") @db.Uuid
  decididoPor    String   @map("decidido_por") @db.Uuid
  decididoNombre String   @map("decidido_nombre") @db.VarChar(200)
  decididoEn     DateTime @default(now()) @map("decidido_en") @db.Timestamptz(3)

  revision Revision  @relation(fields: [organizacionId, revisionId, versionId], references: [organizacionId, id, versionId], onDelete: Restrict, onUpdate: Restrict, map: "excepcion_decision_revision_fk")
  autor    Membresia @relation(fields: [organizacionId, decididoPor], references: [organizacionId, usuarioId], onDelete: Restrict, onUpdate: Restrict, map: "excepcion_decision_autor_fk")

  @@unique([organizacionId, versionId, numero], map: "excepcion_decision_unica_key")
  @@index([organizacionId, revisionId])
  @@map("excepcion_decision")
}
