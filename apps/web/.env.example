# Configuración PÚBLICA de la web (Vite incrusta las variables VITE_* en el código del navegador).
# Nunca pongas aquí contraseñas, tokens ni cadenas de conexión.
#
# URL de la API local. Debe ser http://localhost:<puerto>, sin ruta ni credenciales.
# Por qué localhost y no 127.0.0.1 (ADR-0007): la web se abre en http://localhost:5173 y la cookie
# de sesión (SameSite=Strict, host-only) solo viaja si la API es del mismo site. La API sigue
# escuchando solo en 127.0.0.1.
VITE_API_URL=http://localhost:3000
