# Plantilla de variables. NUNCA pongas credenciales reales aquí.
#
# Los archivos reales los genera, con contraseñas aleatorias y sin mostrarlas:
#     cd apps/api && node scripts/db/generar-credenciales.mjs
# y quedan en apps/api/.env (desarrollo) y apps/api/.env.test (integración), excluidos de Git.

# --- Ambiente -------------------------------------------------------------
# DEMO: datos ilustrativos, todo PDF y pantalla marcados como demostración.
# PRODUCCION: solo con parámetros reales validados (no disponible todavía).
APP_ENV=DEMO
NODE_ENV=development

# --- PostgreSQL local (apps/api/.env) -------------------------------------
# Servidor: PostgreSQL 18 en localhost:5432 (servicio postgresql-x64-18). Ver ADR-0004.
# Rol de la aplicación: SELECT/INSERT/UPDATE, sin DDL ni DELETE. Nunca el superusuario postgres.
DATABASE_URL=postgresql://softarq_app:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_dev
# Rol migrador: solo la CLI de Prisma y los scripts de migración y permisos.
MIGRATION_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_dev
# Base sombra: solo para generar migraciones nuevas (prisma migrate dev --create-only).
SHADOW_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_shadow

# --- PostgreSQL de pruebas (apps/api/.env.test) ---------------------------
# Las pruebas de integración SOLO aceptan la base softarq_test en localhost y la vacían.
# DATABASE_URL=postgresql://softarq_app:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_test
# MIGRATION_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_test

# Archivo de entorno que leen prisma.config.ts y la carga DEMO (por omisión .env).
# SOFTARQ_ENV_FILE=.env

# --- API HTTP local (apps/api/.env; ADR-0005) --------------------------------
# Todas son opcionales: se muestran sus valores por omisión. El arranque falla con un mensaje
# claro si alguna es inválida. DATABASE_URL (arriba) debe usar el rol softarq_app.
# Solo 127.0.0.1: cualquier otro valor se rechaza (sin acceso desde la red local ni Expo).
API_HOST=127.0.0.1
API_PORT=3000
# Orígenes http locales explícitos (separados por coma). Nunca "*". Con credenciales (cookie de
# sesión): solo localhost, el mismo site que la API vista desde el navegador (ADR-0007).
API_CORS_ORIGINS=http://localhost:5173
# Rate limiting en memoria por IP (una sola instancia).
API_LIMITE_GENERAL_POR_MINUTO=120
API_LIMITE_CALCULO_POR_MINUTO=30
# Tamaño máximo del cuerpo JSON (KB).
API_LIMITE_CUERPO_KB=128
# Registro HTTP: completo | errores | ninguno (nunca registra cuerpos ni secretos).
API_REGISTRO=completo
# Límites de intentos de acceso (ADR-0007): ventanas fijas en memoria, nunca bloqueos permanentes.
API_ACCESO_VENTANA_MINUTOS=15
API_ACCESO_FALLOS_CUENTA_IP=5
API_ACCESO_FALLOS_CUENTA=20
API_ACCESO_INTENTOS_IP=30
# (Módulo 5) SOFTARQ_ORGANIZACION_DEMO se eliminó: la organización sale de la sesión del usuario.
# NODE_ENV=production hace fallar el arranque: la cookie de sesión no lleva Secure (HTTP local).
# Zona horaria de la fecha de cálculo (vigencias).
SOFTARQ_ZONA_HORARIA=America/Mexico_City
# (Módulo 8, ADR-0010) Carpeta PERSISTENTE de los PDF emitidos: originales, no caché. Obligatoria
# para arrancar la API. Ruta absoluta FUERA del repositorio y de _work (que es temporal); respáldela
# junto con la base (pg_dump). Las pruebas usan _work\pruebas\documentos-* y nunca esta carpeta.
SOFTARQ_DIR_DOCUMENTOS=D:\Proyecto_SoftArq\datos\softarq_dev\documentos

# --- Clientes ---------------------------------------------------------------
# Web (apps/web/.env.local; ver apps/web/.env.example). Configuración PÚBLICA: Vite la incrusta en
# el código del navegador, así que nunca lleva secretos ni contraseñas. Solo http://localhost con
# puerto (mismo site que la web, para la cookie de sesión SameSite=Strict; la API sigue escuchando
# en 127.0.0.1); cualquier otro valor hace fallar la compilación. Por omisión http://localhost:3000.
# La web se abre en http://localhost:5173 (origen permitido en API_CORS_ORIGINS); sin proxy.
VITE_API_URL=http://localhost:3000
# URL de la API vista desde Expo (usa la IP de la red local en un dispositivo físico)
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Moneda -----------------------------------------------------------------
# Única moneda (D-18). No editable.
APP_CURRENCY=MXN
