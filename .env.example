# Copia este archivo como .env (no se versiona) y completa los valores locales.
# Nunca pongas credenciales reales en .env.example.

# --- Ambiente -------------------------------------------------------------
# DEMO: datos ilustrativos, todo PDF y pantalla marcados como demostración.
# PRODUCCION: solo con parámetros reales validados (no disponible todavía).
APP_ENV=DEMO
NODE_ENV=development

# --- API ------------------------------------------------------------------
API_PORT=3000
# Orígenes permitidos para CORS (separados por coma)
API_CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL local -----------------------------------------------------
# Servidor local: PostgreSQL 18 en localhost:5432 (servicio postgresql-x64-18).
# Usa un usuario y una base exclusivos de SoftArq, no el superusuario postgres.
DATABASE_URL=postgresql://softarq_dev:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_dev

# --- Clientes -------------------------------------------------------------
# URL de la API vista desde la web (Vite expone solo variables VITE_*)
VITE_API_URL=http://localhost:3000
# URL de la API vista desde Expo (usa la IP de la red local en un dispositivo físico)
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Moneda ---------------------------------------------------------------
# Única moneda (D-18). No editable.
APP_CURRENCY=MXN
