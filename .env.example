# Plantilla de variables. NUNCA pongas credenciales reales aquí.
#
# Los archivos reales los genera, con contraseñas aleatorias y sin mostrarlas:
#     cd apps/api && node scripts/db/generar-credenciales.mjs
# y quedan en apps/api/.env (desarrollo) y apps/api/.env.test (integración), excluidos de Git.

# --- Ambiente -------------------------------------------------------------
# DEMO: datos ilustrativos, todo PDF y pantalla marcados como demostración.
# PRODUCCION: solo con parámetros reales validados (no disponible todavía).
APP_ENV=DEMO
NODE_ENV=development

# --- PostgreSQL local (apps/api/.env) -------------------------------------
# Servidor: PostgreSQL 18 en localhost:5432 (servicio postgresql-x64-18). Ver ADR-0004.
# Rol de la aplicación: SELECT/INSERT/UPDATE, sin DDL ni DELETE. Nunca el superusuario postgres.
DATABASE_URL=postgresql://softarq_app:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_dev
# Rol migrador: solo la CLI de Prisma y los scripts de migración y permisos.
MIGRATION_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_dev
# Base sombra: solo para generar migraciones nuevas (prisma migrate dev --create-only).
SHADOW_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_shadow

# --- PostgreSQL de pruebas (apps/api/.env.test) ---------------------------
# Las pruebas de integración SOLO aceptan la base softarq_test en localhost y la vacían.
# DATABASE_URL=postgresql://softarq_app:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_test
# MIGRATION_DATABASE_URL=postgresql://softarq_migrator:CAMBIAR_EN_ENV_LOCAL@localhost:5432/softarq_test

# Archivo de entorno que leen prisma.config.ts y la carga DEMO (por omisión .env).
# SOFTARQ_ENV_FILE=.env

# --- API (módulo posterior) -------------------------------------------------
API_PORT=3000
# Orígenes permitidos para CORS (separados por coma)
API_CORS_ORIGINS=http://localhost:5173

# --- Clientes ---------------------------------------------------------------
# URL de la API vista desde la web (Vite expone solo variables VITE_*)
VITE_API_URL=http://localhost:3000
# URL de la API vista desde Expo (usa la IP de la red local en un dispositivo físico)
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Moneda -----------------------------------------------------------------
# Única moneda (D-18). No editable.
APP_CURRENCY=MXN
