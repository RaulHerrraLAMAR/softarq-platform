{
  "openapi": "3.1.0",
  "info": {
    "title": "SoftArq API (DEMO local)",
    "version": "1.0.0",
    "description": "API local de SoftArq: catálogos DEMO y cálculo de cotizaciones con datos de PostgreSQL. Solo escucha en 127.0.0.1. Autenticación con sesión opaca en una cookie HttpOnly (`softarq_sesion`); la organización, la identidad y las funciones salen de la sesión (ADR-0007). Las solicitudes POST y DELETE exigen la cabecera X-CSRF-Token de la sesión y un Origin permitido. Los importes y cantidades viajan como texto decimal. Todos los datos son DEMO y no tienen validez comercial."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "API local (escucha en 127.0.0.1; el navegador usa localhost)."
    }
  ],
  "security": [
    {
      "cookieSesion": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Salud del servicio y de PostgreSQL",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio y base de datos disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          },
          "429": {
            "description": "DEMASIADAS_SOLICITUDES (cabecera Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "summary": "Crea la sesión previa al acceso (cookie) y devuelve su token CSRF",
        "security": [],
