  "components": {
    "securitySchemes": {
      "cookieSesion": {
        "type": "apiKey",
        "in": "cookie",
        "name": "softarq_sesion",
        "description": "Sesión opaca (HttpOnly, SameSite=Strict, Path=/api/v1, host-only)."
      },
      "tokenCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Token CSRF de la sesión (GET /api/v1/auth/csrf antes del acceso; después, el de la respuesta de sesión)."
      }
    },
    "schemas": {
      "SolicitudAcceso": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "contrasena": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "correo",
          "contrasena"
        ],
        "additionalProperties": false
      },
      "RespuestaCsrf": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "RespuestaSesion": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "correo": {
                "type": "string"
              }
            },
            "required": [
              "nombre",
              "correo"
            ],
            "additionalProperties": false
          },
          "organizacion": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string"
              },
              "nombre": {
                "type": "string"
              },
              "esDemo": {
                "type": "boolean"
              }
            },
            "required": [
              "codigo",
              "nombre",
              "esDemo"
            ],
            "additionalProperties": false
          },
          "funciones": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PREPARADOR",
                "REVISOR",
                "ADMIN_CATALOGO",
                "ADMIN_SISTEMA"
              ]
            }
          },
          "capacidades": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sesion.propia",
                "catalogos.consultar",
                "calculo.ejecutar"
              ]
            }
          },
          "expiraEn": {
            "type": "string"
          },
          "inactividadMinutos": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "csrfToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "usuario",
          "organizacion",
          "funciones",
          "capacidades",
          "expiraEn",
