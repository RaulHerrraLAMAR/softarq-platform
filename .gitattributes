# Finales de línea LF en el repositorio, independientemente de core.autocrlf
* text=auto eol=lf

# Scripts de Windows con CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
